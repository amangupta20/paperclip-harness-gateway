[Unit]
Description=Paperclip harness gateway (Claude Code / pi / Codex agents)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=@NODE@ @ROOT@/bridge/bridge.mjs
Environment=PATH=@PATH@
Environment=BRIDGE_BIND=@BIND@
# Binding to a tailnet IP fails until tailscale is up; keep retrying.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
